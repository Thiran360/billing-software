package com.store.billing.ui;

import com.store.billing.dao.BillDAO;
import com.store.billing.dao.ProductDAO;
import com.store.billing.dao.SettingsDAO;
import com.store.billing.model.Bill;
import com.store.billing.model.BillItem;
import com.store.billing.model.Product;

import javax.swing.*;
import javax.swing.table.DefaultTableModel;
import java.awt.*;
import java.text.SimpleDateFormat;
import java.util.ArrayList;
import java.util.List;
import com.store.billing.model.Customer;

public class BillingPanel extends JPanel {
    private JTextField txtQuantity;
    private JComboBox<Object> cmbCustomer;
    private JComboBox<Product> cmbProducts;
    private JComboBox<String> cmbUnitType;
    private JCheckBox chkIncludeUpi, chkManualAmount;
    private JComboBox<String> cmbUpiList;
    private JComboBox<String> cmbPaymentMode;
    private JComboBox<String> cmbPrintLanguage;
    private JSpinner itemsPerPageSpinner;
    private JLabel lblTotal;
    private JTable cartTable;
    private DefaultTableModel cartModel;
    
    private ProductDAO productDAO;
    private BillDAO billDAO;
    private SettingsDAO settingsDAO;
    private com.store.billing.dao.CustomerDAO customerDAO;
    
    private List<BillItem> currentItems;
    private List<Product> allProducts = new ArrayList<>();
    private double currentTotal = 0.0;

    public BillingPanel() {
        productDAO = new ProductDAO();
        billDAO = new BillDAO();
        settingsDAO = new SettingsDAO();
        customerDAO = new com.store.billing.dao.CustomerDAO();
        currentItems = new ArrayList<>();

        setLayout(new BorderLayout(10, 10));
        setBorder(BorderFactory.createEmptyBorder(10, 10, 10, 10));

        // Top Panel for Data Entry (GridBagLayout for better alignment)
        JPanel topPanel = new JPanel(new GridBagLayout());
        topPanel.setBorder(BorderFactory.createTitledBorder("Billing Details"));
        GridBagConstraints gbc = new GridBagConstraints();
        gbc.insets = new Insets(10, 10, 10, 10);
        gbc.fill = GridBagConstraints.HORIZONTAL;
        
        gbc.gridx = 0; gbc.gridy = 0;
        topPanel.add(new JLabel("Customer Name (Optional):"), gbc);
        
        gbc.gridx = 1; gbc.gridy = 0;
        cmbCustomer = new JComboBox<>();
        cmbCustomer.setEditable(true);
        cmbCustomer.setFont(new Font("SansSerif", Font.PLAIN, 16));
        topPanel.add(cmbCustomer, gbc);
        
        gbc.gridx = 2; gbc.gridy = 0;
        topPanel.add(new JLabel("Select Product:"), gbc);
        
        gbc.gridx = 3; gbc.gridy = 0;
        cmbProducts = new JComboBox<>();
        cmbProducts.setFont(new Font("Nirmala UI", Font.PLAIN, 15));
        cmbProducts.setPreferredSize(new Dimension(250, 30));
        final boolean[] isFiltering = {false};
        cmbProducts.setEditor(new javax.swing.plaf.basic.BasicComboBoxEditor() {
            @Override
            public void setItem(Object item) {
                if (isFiltering[0]) return;
                super.setItem(item);
            }
        });
        cmbProducts.setEditable(true);
        JTextField productEditor = (JTextField) cmbProducts.getEditor().getEditorComponent();
        productEditor.addKeyListener(new java.awt.event.KeyAdapter() {
            @Override
            public void keyReleased(java.awt.event.KeyEvent e) {
                if (e.getKeyCode() == java.awt.event.KeyEvent.VK_UP || 
                    e.getKeyCode() == java.awt.event.KeyEvent.VK_DOWN || 
                    e.getKeyCode() == java.awt.event.KeyEvent.VK_ENTER ||
                    e.getKeyCode() == java.awt.event.KeyEvent.VK_ESCAPE ||
                    e.getKeyCode() == java.awt.event.KeyEvent.VK_LEFT ||
                    e.getKeyCode() == java.awt.event.KeyEvent.VK_RIGHT) {
                    return;
                }
                
                SwingUtilities.invokeLater(() -> {
                    isFiltering[0] = true;
                    String text = productEditor.getText();
                    cmbProducts.removeAllItems();
                    if (text.isEmpty()) {
                        for (Product p : allProducts) cmbProducts.addItem(p);
                        cmbProducts.hidePopup();
                    } else {
                        for (Product p : allProducts) {
                            if (p.getName().toLowerCase().contains(text.toLowerCase()) || 
                               (p.getTamilName() != null && p.getTamilName().contains(text))) {
                                cmbProducts.addItem(p);
                            }
                        }
                        if (cmbProducts.getItemCount() > 0) {
                            cmbProducts.showPopup();
                        } else {
                            cmbProducts.hidePopup();
                        }
                    }
                    productEditor.setText(text);
                    isFiltering[0] = false;
                });
            }
        });
        
        topPanel.add(cmbProducts, gbc);
        
        gbc.gridx = 0; gbc.gridy = 1;
        topPanel.add(new JLabel("Quantity:"), gbc);
        
        gbc.gridx = 1; gbc.gridy = 1;
        txtQuantity = new JTextField("1", 10);
        txtQuantity.setFont(new Font("SansSerif", Font.PLAIN, 16));
        topPanel.add(txtQuantity, gbc);
        
        gbc.gridx = 2; gbc.gridy = 1;
        topPanel.add(new JLabel("Unit Type:"), gbc);
        
        gbc.gridx = 3; gbc.gridy = 1;
        cmbUnitType = new JComboBox<>(new String[]{"Piece", "Dozen", "Box", "Kg", "Gram", "Liter"});
        cmbUnitType.setEditable(true);
        cmbUnitType.setFont(new Font("SansSerif", Font.PLAIN, 14));
        topPanel.add(cmbUnitType, gbc);
        
        gbc.gridx = 0; gbc.gridy = 2;
        gbc.anchor = GridBagConstraints.WEST;
        chkIncludeUpi = new JCheckBox("Include UPI QR");
        chkIncludeUpi.setFont(new Font("SansSerif", Font.BOLD, 14));
        topPanel.add(chkIncludeUpi, gbc);
        
        gbc.gridx = 1; gbc.gridy = 2;
        gbc.fill = GridBagConstraints.HORIZONTAL;
        cmbUpiList = new JComboBox<>();
        cmbUpiList.setFont(new Font("SansSerif", Font.PLAIN, 14));
        topPanel.add(cmbUpiList, gbc);
        
        gbc.gridx = 2; gbc.gridy = 2;
        gbc.gridwidth = 2;
        gbc.anchor = GridBagConstraints.WEST;
        chkManualAmount = new JCheckBox("Manual Amount Entry");
        chkManualAmount.setFont(new Font("SansSerif", Font.BOLD, 14));
        topPanel.add(chkManualAmount, gbc);
        
        // Reset gridwidth
        gbc.gridwidth = 1;
        
        // Row 3
        gbc.gridx = 0; gbc.gridy = 3;
        gbc.anchor = GridBagConstraints.WEST;
        topPanel.add(new JLabel("Items per Page:"), gbc);
        
        gbc.gridx = 1; gbc.gridy = 3;
        gbc.fill = GridBagConstraints.HORIZONTAL;
        SpinnerNumberModel spinnerModel = new SpinnerNumberModel(15, 1, 100, 1);
        itemsPerPageSpinner = new JSpinner(spinnerModel);
        itemsPerPageSpinner.setFont(new Font("SansSerif", Font.PLAIN, 14));
        topPanel.add(itemsPerPageSpinner, gbc);
        
        gbc.gridx = 2; gbc.gridy = 3;
        gbc.anchor = GridBagConstraints.WEST;
        topPanel.add(new JLabel("Payment Mode:"), gbc);
        
        gbc.gridx = 3; gbc.gridy = 3;
        gbc.fill = GridBagConstraints.HORIZONTAL;
        cmbPaymentMode = new JComboBox<>(new String[]{"Cash", "GPay / PhonePe", "Card"});
        cmbPaymentMode.setFont(new Font("SansSerif", Font.PLAIN, 14));
        topPanel.add(cmbPaymentMode, gbc);
        
        // Row 4
        gbc.gridx = 0; gbc.gridy = 4;
        gbc.anchor = GridBagConstraints.WEST;
        topPanel.add(new JLabel("Print Lang:"), gbc);
        
        gbc.gridx = 1; gbc.gridy = 4;
        gbc.fill = GridBagConstraints.HORIZONTAL;
        cmbPrintLanguage = new JComboBox<>(new String[]{"English", "Tamil"});
        cmbPrintLanguage.setFont(new Font("SansSerif", Font.PLAIN, 14));
        topPanel.add(cmbPrintLanguage, gbc);
        
        gbc.gridx = 3; gbc.gridy = 4;
        gbc.fill = GridBagConstraints.NONE;
        gbc.anchor = GridBagConstraints.EAST;
        JButton btnAdd = new JButton("Add to Cart");
        btnAdd.setFont(new Font("SansSerif", Font.BOLD, 14));
        btnAdd.addActionListener(e -> addProductToCart());
        topPanel.add(btnAdd, gbc);
        
        // Update Unit dropdown dynamically when product is selected
        cmbProducts.addActionListener(e -> {
            if (isFiltering[0]) return; // Skip if we are actively filtering
            
            Object selected = cmbProducts.getSelectedItem();
            if (selected instanceof Product) {
                cmbUnitType.setSelectedItem(((Product) selected).getUnitType());
                txtQuantity.requestFocus();
            } else if (selected instanceof String) {
                // User pressed Enter after typing a partial name
                if (cmbProducts.getItemCount() > 0) {
                    Object firstItem = cmbProducts.getItemAt(0);
                    if (firstItem instanceof Product) {
                        SwingUtilities.invokeLater(() -> {
                            cmbProducts.setSelectedItem(firstItem);
                            cmbUnitType.setSelectedItem(((Product) firstItem).getUnitType());
                            txtQuantity.requestFocus();
                        });
                    }
                }
            }
        });
        
        add(topPanel, BorderLayout.NORTH);

        // Center Panel for Cart Table
        String[] columns = {"Product ID", "Name", "Unit Price", "Unit Type", "Qty", "Subtotal"};
        cartModel = new DefaultTableModel(columns, 0) {
            @Override
            public boolean isCellEditable(int row, int column) {
                return false;
            }
        };
        cartTable = new JTable(cartModel);
        cartTable.setRowHeight(30);
        cartTable.setFont(new Font("Nirmala UI", Font.PLAIN, 15));
        cartTable.getTableHeader().setFont(new Font("SansSerif", Font.BOLD, 14));
        add(new JScrollPane(cartTable), BorderLayout.CENTER);

        // Bottom Panel for Total and Checkout
        JPanel bottomPanel = new JPanel(new BorderLayout());
        
        lblTotal = new JLabel("Total: \u20B90.00");
        lblTotal.setFont(new Font("SansSerif", Font.BOLD, 28));
        lblTotal.setForeground(new Color(40, 167, 69)); // Green color
        lblTotal.setBorder(BorderFactory.createEmptyBorder(10, 10, 10, 10));
        bottomPanel.add(lblTotal, BorderLayout.WEST);
        
        JPanel buttonPanel = new JPanel(new FlowLayout(FlowLayout.RIGHT, 15, 10));
        
        JButton btnClear = new JButton("Clear Cart");
        btnClear.setFont(new Font("SansSerif", Font.BOLD, 16));
        btnClear.addActionListener(e -> clearCart());
        buttonPanel.add(btnClear);
        
        JButton btnCheckout = new JButton("Checkout & Print");
        btnCheckout.setFont(new Font("SansSerif", Font.BOLD, 18));
        btnCheckout.setBackground(new Color(0, 123, 255));
        btnCheckout.setForeground(Color.WHITE);
        btnCheckout.setFocusPainted(false);
        btnCheckout.addActionListener(e -> processCheckout());
        buttonPanel.add(btnCheckout);
        
        bottomPanel.add(buttonPanel, BorderLayout.EAST);
        
        add(bottomPanel, BorderLayout.SOUTH);
        
        setupKeyboardShortcuts();
        
        refreshProducts();
        loadUpiSettings();
    }
    
    public void loadUpiSettings() {
        boolean enabled = Boolean.parseBoolean(settingsDAO.getSetting("upi_enabled", "false"));
        chkIncludeUpi.setSelected(enabled);
        
        cmbUpiList.removeAllItems();
        String upiString = settingsDAO.getSetting("upi_ids", "");
        if (!upiString.isEmpty()) {
            String[] ids = upiString.split(",");
            for (String id : ids) {
                if (!id.trim().isEmpty()) {
                    cmbUpiList.addItem(id.trim());
                }
            }
        }
    }
    
    private void setupKeyboardShortcuts() {
        // Customer Name -> Product Dropdown
        Component editor = cmbCustomer.getEditor().getEditorComponent();
        if (editor instanceof JTextField) {
            ((JTextField) editor).addActionListener(e -> cmbProducts.requestFocusInWindow());
        }
        
        // Product Dropdown -> Quantity (Forward) / Customer Name (Backward)
        cmbProducts.getInputMap(JComponent.WHEN_ANCESTOR_OF_FOCUSED_COMPONENT)
                   .put(KeyStroke.getKeyStroke(java.awt.event.KeyEvent.VK_ENTER, 0), "enterPressed");
        cmbProducts.getActionMap().put("enterPressed", new AbstractAction() {
            @Override
            public void actionPerformed(java.awt.event.ActionEvent e) {
                if (!cmbProducts.isPopupVisible()) {
                    txtQuantity.requestFocusInWindow();
                    txtQuantity.selectAll();
                } else {
                    cmbProducts.setPopupVisible(false);
                }
            }
        });
        
        cmbProducts.getInputMap(JComponent.WHEN_ANCESTOR_OF_FOCUSED_COMPONENT)
                   .put(KeyStroke.getKeyStroke(java.awt.event.KeyEvent.VK_LEFT, 0), "leftPressed");
        cmbProducts.getActionMap().put("leftPressed", new AbstractAction() {
            @Override
            public void actionPerformed(java.awt.event.ActionEvent e) {
                if (!cmbProducts.isPopupVisible()) {
                    cmbCustomer.requestFocusInWindow();
                }
            }
        });
        
        // Quantity -> Unit Type (Forward) / Product Dropdown (Backward)
        txtQuantity.addActionListener(e -> cmbUnitType.requestFocusInWindow());
        txtQuantity.addKeyListener(new java.awt.event.KeyAdapter() {
            @Override
            public void keyPressed(java.awt.event.KeyEvent e) {
                if (e.getKeyCode() == java.awt.event.KeyEvent.VK_LEFT && txtQuantity.getCaretPosition() == 0) {
                    cmbProducts.requestFocusInWindow();
                } else if (e.getKeyCode() == java.awt.event.KeyEvent.VK_DOWN) {
                    try {
                        int qty = Integer.parseInt(txtQuantity.getText().trim());
                        txtQuantity.setText(String.valueOf(qty + 1));
                    } catch (NumberFormatException ex) {
                        txtQuantity.setText("1");
                    }
                } else if (e.getKeyCode() == java.awt.event.KeyEvent.VK_UP) {
                    try {
                        int qty = Integer.parseInt(txtQuantity.getText().trim());
                        if (qty > 1) {
                            txtQuantity.setText(String.valueOf(qty - 1));
                        }
                    } catch (NumberFormatException ex) {
                        txtQuantity.setText("1");
                    }
                }
            }
        });
        
        // Unit Type -> Add to Cart (Forward) / Quantity (Backward)
        Component unitEditor = cmbUnitType.getEditor().getEditorComponent();
        if (unitEditor instanceof JTextField) {
            JTextField unitTxt = (JTextField) unitEditor;
            unitTxt.addKeyListener(new java.awt.event.KeyAdapter() {
                @Override
                public void keyPressed(java.awt.event.KeyEvent e) {
                    if (e.getKeyCode() == java.awt.event.KeyEvent.VK_ENTER) {
                        addProductToCart();
                        cmbProducts.requestFocusInWindow();
                    } else if (e.getKeyCode() == java.awt.event.KeyEvent.VK_LEFT && unitTxt.getCaretPosition() == 0) {
                        txtQuantity.requestFocusInWindow();
                    }
                }
            });
        }
        
        // F12 -> Checkout & Print
        this.getInputMap(JComponent.WHEN_IN_FOCUSED_WINDOW).put(KeyStroke.getKeyStroke(java.awt.event.KeyEvent.VK_F12, 0), "checkout");
        this.getActionMap().put("checkout", new AbstractAction() {
            @Override
            public void actionPerformed(java.awt.event.ActionEvent e) {
                processCheckout();
            }
        });
        
        // F5 -> Clear Cart
        this.getInputMap(JComponent.WHEN_IN_FOCUSED_WINDOW).put(KeyStroke.getKeyStroke(java.awt.event.KeyEvent.VK_F5, 0), "clear");
        this.getActionMap().put("clear", new AbstractAction() {
            @Override
            public void actionPerformed(java.awt.event.ActionEvent e) {
                clearCart();
            }
        });
        
        // Update tooltips for buttons to show shortcuts
        // bottomPanel is getComponent(2). It has: 0=lblTotal, 1=buttonPanel
        JPanel bottomPanel = (JPanel) getComponent(2);
        JPanel buttonPanel = (JPanel) bottomPanel.getComponent(1);
        JButton btnClear = (JButton) buttonPanel.getComponent(0);
        JButton btnCheckout = (JButton) buttonPanel.getComponent(1);
        btnClear.setText("Clear Cart (F5)");
        btnCheckout.setText("Checkout & Print (F12)");
    }

    
    public void refreshProducts() {
        cmbProducts.removeAllItems();
        allProducts = productDAO.getAllProducts();
        for (Product p : allProducts) {
            cmbProducts.addItem(p);
        }
        cmbProducts.setSelectedItem(null); // Leave text field blank initially
    }

    private void addProductToCart() {
        Object selected = cmbProducts.getSelectedItem();
        Product selectedProduct = null;
        
        if (selected instanceof Product) {
            selectedProduct = (Product) selected;
        } else if (selected instanceof String) {
            String text = (String) selected;
            for (Product p : allProducts) {
                if ((p.getTamilName() != null && p.getTamilName().equals(text)) || p.getName().equalsIgnoreCase(text)) {
                    selectedProduct = p;
                    break;
                }
            }
        }
        
        if (selectedProduct == null) {
            JOptionPane.showMessageDialog(this, "Please select a product first.", "Error", JOptionPane.WARNING_MESSAGE);
            return;
        }
        
        int qty = 1;
        try {
            qty = Integer.parseInt(txtQuantity.getText().trim());
            if (qty <= 0) throw new NumberFormatException();
        } catch (NumberFormatException ex) {
            JOptionPane.showMessageDialog(this, "Please enter a valid quantity.", "Error", JOptionPane.WARNING_MESSAGE);
            return;
        }

        // Check if already in cart
        boolean found = false;
        for (BillItem item : currentItems) {
            if (item.getProductId() == selectedProduct.getId()) {
                item.setQuantity(item.getQuantity() + qty);
                item.setSubtotal(item.getQuantity() * item.getUnitPrice());
                found = true;
                break;
            }
        }
        
        if (!found) {
            BillItem newItem = new BillItem();
            newItem.setProductId(selectedProduct.getId());
            newItem.setProductName(selectedProduct.getName());
            newItem.setTamilName(selectedProduct.getTamilName());
            newItem.setQuantity(qty);
            newItem.setUnitPrice(selectedProduct.getPrice());
            newItem.setSubtotal(selectedProduct.getPrice() * qty);
            
            String selectedUnit = cmbUnitType.getSelectedItem() != null ? cmbUnitType.getSelectedItem().toString() : selectedProduct.getUnitType();
            newItem.setUnitType(selectedUnit);
            
            currentItems.add(newItem);
        }
        
        updateCartTable();
        txtQuantity.setText("1");
        cmbProducts.setSelectedItem(null); // Clear the selection for next item
    }

    private void updateCartTable() {
        cartModel.setRowCount(0);
        currentTotal = 0.0;
        
        for (BillItem item : currentItems) {
            cartModel.addRow(new Object[]{
                    item.getProductId(),
                    item.getProductName(),
                    String.format("%.2f", item.getUnitPrice()),
                    item.getUnitType(),
                    item.getQuantity(),
                    String.format("%.2f", item.getSubtotal())
            });
            currentTotal += item.getSubtotal();
        }
        lblTotal.setText(String.format("Total: \u20B9%.2f", currentTotal));
    }

    private void clearCart() {
        currentItems.clear();
        cartModel.setRowCount(0);
        lblTotal.setText("Total: \u20B90.00");
        currentTotal = 0.0;
        cmbCustomer.setSelectedItem("");
        txtQuantity.setText("1");
    }

    public void loadCustomers() {
        cmbCustomer.removeAllItems();
        cmbCustomer.addItem("");
        List<Customer> customers = customerDAO.getAllCustomers();
        for (Customer c : customers) {
            cmbCustomer.addItem(c);
        }
    }

    private void processCheckout() {
        if (currentItems.isEmpty()) {
            JOptionPane.showMessageDialog(this, "Cart is empty.");
            return;
        }

        Object selectedCustomerObj = cmbCustomer.getSelectedItem();
        String customerName = "";
        Customer customerObj = null;
        
        if (selectedCustomerObj != null) {
            if (selectedCustomerObj instanceof Customer) {
                customerObj = (Customer) selectedCustomerObj;
                customerName = customerObj.getName();
            } else {
                customerName = selectedCustomerObj.toString().trim();
            }
        }

        String paymentMode = cmbPaymentMode.getSelectedItem().toString();
        
        Bill bill = new Bill();
        bill.setCustomerName(customerName);
        bill.setCustomerObj(customerObj);
        bill.setPaymentMode(paymentMode);
        bill.setTotalAmount(currentTotal);
        bill.setItems(new ArrayList<>(currentItems));

        if (billDAO.createBill(bill)) {
            printReceipt(bill);
            clearCart();
        } else {
            JOptionPane.showMessageDialog(this, "Failed to generate bill. Check DB connection and product stock.");
        }
    }
    
    private String centerText(String text, int width) {
        if (text == null) return "";
        if (text.length() >= width) return text;
        int padding = (width - text.length()) / 2;
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < padding; i++) sb.append(" ");
        sb.append(text);
        return sb.toString();
    }
    
    private void printReceipt(Bill bill) {
        String shopName = settingsDAO.getSetting("shop_name", "MUSTAFA STORES");
        String shopAddress = settingsDAO.getSetting("shop_address", "123 Main Street");
        String shopPhone = settingsDAO.getSetting("shop_phone", "9876543210");
        
        int itemsPerPage = (Integer) itemsPerPageSpinner.getValue();
        List<BillItem> items = bill.getItems();
        int totalPages = (int) Math.ceil((double) items.size() / itemsPerPage);
        if (totalPages == 0) totalPages = 1;

        JTabbedPane tabbedPane = new JTabbedPane();

        SimpleDateFormat dateFormat = new SimpleDateFormat("dd.MM.yyyy");
        String dateStr = dateFormat.format(new java.util.Date());
        String noStr = "No. " + bill.getId();

        for (int p = 0; p < totalPages; p++) {
            String pageStr = "Page " + (p + 1) + " / " + totalPages;
            
            StringBuilder html = new StringBuilder();
            html.append("<html><body style='font-family: \"Nirmala UI\", sans-serif; font-size: 11px; margin: 5px; width: 300px;'>");
            html.append("<div style='text-align: center;'>");
            html.append("<b style='font-size: 14px;'>").append(shopName.toUpperCase()).append("</b><br>");
            html.append(shopAddress).append("<br>");
            html.append("Phone No: ").append(shopPhone).append("<br>");
            
            String modeStr = bill.getPaymentMode() != null ? bill.getPaymentMode() : "Cash";
            html.append(modeStr).append(" Bill<br>");
            html.append("</div><hr style='border: 1px dashed black;'>");
            
            html.append("<table width='100%' style='font-size: 11px;'>");
            html.append("<tr><td style='text-align:left;'>").append(noStr).append("</td>");
            html.append("<td style='text-align:center;'>").append(dateStr).append("</td>");
            html.append("<td style='text-align:right;'>").append(pageStr).append("</td></tr>");
            html.append("</table>");
            
            html.append("<div style='margin-top: 5px;'>To: ").append(bill.getCustomerName().isEmpty() ? "Walk-in" : bill.getCustomerName()).append("<br>");
            if (bill.getCustomerObj() != null) {
                if (bill.getCustomerObj().getMobile() != null && !bill.getCustomerObj().getMobile().isEmpty()) {
                    html.append("&nbsp;&nbsp;&nbsp;&nbsp;Ph: ").append(bill.getCustomerObj().getMobile()).append("<br>");
                }
                if (bill.getCustomerObj().getAddress() != null && !bill.getCustomerObj().getAddress().isEmpty()) {
                    html.append("&nbsp;&nbsp;&nbsp;&nbsp;").append(bill.getCustomerObj().getAddress()).append("<br>");
                }
            }
            html.append("</div><hr style='border: 1px dashed black;'>");
            
            html.append("<table width='100%' cellspacing='0' cellpadding='2' style='font-size: 11px;'>");
            html.append("<tr><th align='left' width='10%'>No.</th><th align='left' width='45%'>Item</th><th align='right' width='25%'>Qty</th><th align='right' width='20%'>Total</th></tr>");
            html.append("<tr><td colspan='4'><hr style='border: 1px dashed black;'></td></tr>");
            
            int start = p * itemsPerPage;
            int end = Math.min(start + itemsPerPage, items.size());
            
            boolean printTamil = "Tamil".equals(cmbPrintLanguage.getSelectedItem().toString());
            
            for (int i = start; i < end; i++) {
                BillItem item = items.get(i);
                String itemName = item.getProductName();
                if (printTamil && item.getTamilName() != null && !item.getTamilName().trim().isEmpty()) {
                    itemName = item.getTamilName();
                }
                
                String qtyUnit = item.getQuantity() + " " + (item.getUnitType() != null ? item.getUnitType() : "");
                
                html.append("<tr>");
                html.append("<td align='left' valign='top'>").append(i + 1).append(".</td>");
                html.append("<td align='left' valign='top'>").append(itemName).append("</td>");
                html.append("<td align='right' valign='top'>").append(qtyUnit).append("</td>");
                html.append("<td align='right' valign='top'>").append(String.format("%.2f", item.getSubtotal())).append("</td>");
                html.append("</tr>");
            }
            
            html.append("</table>");
            
            JPanel receiptPanel = new JPanel(new BorderLayout());
            
            if (p == totalPages - 1) {
                // Last page
                html.append("<hr style='border: 1px dashed black;'>");
                html.append("<table width='100%' style='font-size: 11px;'><tr><td align='right'><b>Total: ").append(String.format("%.2f", bill.getTotalAmount())).append("</b></td></tr></table>");
                html.append("<hr style='border: 1px dashed black;'></body></html>");
                
                JTextPane textPane = new JTextPane();
                textPane.setContentType("text/html");
                textPane.setText(html.toString());
                textPane.setEditable(false);
                receiptPanel.add(new JScrollPane(textPane), BorderLayout.CENTER);

                if (chkIncludeUpi.isSelected() && cmbUpiList.getSelectedItem() != null) {
                    String upiId = cmbUpiList.getSelectedItem().toString();
                    boolean includeAmount = !chkManualAmount.isSelected();
                    ImageIcon qrIcon = com.store.billing.util.QRCodeGenerator.generateUPIQRCode(upiId, shopName, bill.getTotalAmount(), includeAmount, 200, 200);
                    if (qrIcon != null) {
                        JLabel qrLabel = new JLabel(qrIcon);
                        qrLabel.setHorizontalAlignment(SwingConstants.CENTER);
                        qrLabel.setBorder(BorderFactory.createEmptyBorder(10, 10, 10, 10));
                        
                        JPanel bottomQrPanel = new JPanel(new BorderLayout());
                        JLabel scanLabel = new JLabel("Scan to Pay using UPI");
                        scanLabel.setHorizontalAlignment(SwingConstants.CENTER);
                        scanLabel.setFont(new Font("SansSerif", Font.BOLD, 14));
                        bottomQrPanel.add(scanLabel, BorderLayout.NORTH);
                        bottomQrPanel.add(qrLabel, BorderLayout.CENTER);
                        
                        receiptPanel.add(bottomQrPanel, BorderLayout.SOUTH);
                    }
                }
            } else {
                // Not the last page
                html.append("</table>");
                html.append("<div style='text-align: center; margin-top: 10px; font-style: italic;'>--- Continued on next page ---</div>");
                html.append("</body></html>");
                
                JTextPane textPane = new JTextPane();
                textPane.setContentType("text/html");
                textPane.setText(html.toString());
                textPane.setEditable(false);
                receiptPanel.add(new JScrollPane(textPane), BorderLayout.CENTER);
            }
            
            tabbedPane.addTab("Page " + (p + 1), receiptPanel);
        }

        JDialog dialog = new JDialog((Frame) SwingUtilities.getWindowAncestor(this), "Print Receipt Preview", true);
        dialog.setLayout(new BorderLayout());
        dialog.add(tabbedPane, BorderLayout.CENTER);
        
        JPanel dialogBtnPanel = new JPanel();
        JButton btnPrint = new JButton("Print Bill");
        btnPrint.setFont(new Font("SansSerif", Font.BOLD, 16));
        btnPrint.addActionListener(e -> {
            Component selected = tabbedPane.getSelectedComponent();
            if (selected instanceof JPanel) {
                JPanel pnl = (JPanel) selected;
                for (Component c : pnl.getComponents()) {
                    if (c instanceof JScrollPane) {
                        Component view = ((JScrollPane) c).getViewport().getView();
                        if (view instanceof JTextPane) {
                            try {
                                boolean done = ((JTextPane) view).print(null, null, true, null, null, true);
                                if (done) {
                                    dialog.dispose();
                                }
                            } catch (Exception ex) {
                                ex.printStackTrace();
                                JOptionPane.showMessageDialog(dialog, "Printing failed: " + ex.getMessage(), "Error", JOptionPane.ERROR_MESSAGE);
                            }
                        }
                    }
                }
            }
        });
        
        JButton btnClose = new JButton("Close");
        btnClose.setFont(new Font("SansSerif", Font.BOLD, 16));
        btnClose.addActionListener(e -> dialog.dispose());
        
        dialogBtnPanel.add(btnPrint);
        dialogBtnPanel.add(btnClose);
        dialog.add(dialogBtnPanel, BorderLayout.SOUTH);
        
        dialog.pack();
        dialog.setLocationRelativeTo(this);
        dialog.setVisible(true);
    }
}
